{
  "manifest_version": 3,
  "name": "Spark Assistant for Chrome",
  "short_name": "Spark",
  "version": "1.0.0",
  "description": "Lets Spark's AI assistant read and manage your Chrome tabs, and lets any site show inside Spark tabs.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Spark Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "sidePanel", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"]
}
