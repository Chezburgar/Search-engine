# Copy this file to .env and fill in your values. Never commit .env.

# Required for Spark AI (overviews, chat, summaries). Get one at https://console.x.ai
XAI_API_KEY=

# Optional: pin a Grok model. If empty, Spark picks the fastest current Grok model
# your key can access (via GET /v1/models).
XAI_MODEL=
# Optional: a different (e.g. more capable) model for the Spark AI chat tab.
XAI_CHAT_MODEL=

# Optional: Keenable web search API key (https://keenable.ai). Spark uses Keenable as its
# main web search provider; without a key it uses Keenable's rate-limited keyless endpoint.
KEENABLE_API_KEY=

# Optional: Brave Search API key for higher-quality web, news and image results.
# Without it Spark uses DuckDuckGo, Bing and Wikipedia (no key needed).
BRAVE_API_KEY=

PORT=3000
# Region for web results, e.g. us-en, uk-en, de-de
SPARK_REGION=us-en
# Max AI requests per IP per 10 minutes
AI_RATE_LIMIT=120
# Set to 1 when running behind a reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=0
