# Copy this file to .env and fill in your values. Never commit .env.

# AI for overviews, chat, image questions and summaries. Set ONE of these:
#   GROQ_API_KEY  Groq (gsk_…), https://console.groq.com — fast, has a free tier
#   XAI_API_KEY   xAI Grok (xai-…), https://console.x.ai
# If both are set, Groq is used (override with AI_PROVIDER=xai).
GROQ_API_KEY=
XAI_API_KEY=

# Optional: pin models (otherwise Spark picks fast ones your key can use).
AI_MODEL=
# A different (e.g. more capable) model for the Spark AI chat tab, and one for image questions.
AI_CHAT_MODEL=
AI_VISION_MODEL=

# Optional: Keenable web search API key (https://keenable.ai). Spark uses Keenable as its
# main web search provider; without a key it uses Keenable's rate-limited keyless endpoint.
KEENABLE_API_KEY=

# Optional: Google API key (AIza…). With the Gemini API ("Generative Language API") allowed on the
# key, Spark searches Google through Gemini's "Grounding with Google Search"; with the YouTube Data
# API v3 allowed, it adds a Videos tab. GOOGLE_CSE_ID (a Programmable Search Engine ID) also enables
# the Custom Search JSON API, for projects that still have access to it.
GOOGLE_API_KEY=
# Optional: a separate Gemini API key (from aistudio.google.com/apikey). Used for Gemini instead of
# GOOGLE_API_KEY. Google Search grounding needs billing on its project; without billing, Spark has
# Gemini read DuckDuckGo's results page instead (Pages build only).
GEMINI_API_KEY=
GOOGLE_CSE_ID=
# Optional: pin the Gemini model (default: the newest Flash-Lite your key can use).
GOOGLE_MODEL=

# Optional: Brave Search API key for higher-quality web, news and image results.
# Without it Spark uses DuckDuckGo, Bing and Wikipedia (no key needed).
BRAVE_API_KEY=

PORT=3000
# Region for web results, e.g. us-en, uk-en, de-de
SPARK_REGION=us-en
# Max AI requests per IP per 10 minutes
AI_RATE_LIMIT=120
# Set to 1 when running behind a reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=0
